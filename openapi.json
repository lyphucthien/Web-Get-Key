{
  "openapi": "3.1.0",
  "info": {
    "title": "LPT Hub public API",
    "version": "1.0.0",
    "description": "LPT Hub's public read-only API. No authentication required. Keys are only issued in the user's browser and are not part of this API. The MCP server is at /mcp."
  },
  "servers": [{ "url": "https://lyphucthien.vercel.app" }],
  "paths": {
    "/api/games": {
      "get": {
        "operationId": "listGames",
        "summary": "List of games supported by LPT Hub",
        "description": "Returns games that are supported (status on) and coming soon (status soon), sorted. The result is cached briefly.",
        "responses": {
          "200": {
            "description": "List of games",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GamesResponse" }
              }
            }
          },
          "405": {
            "description": "Only GET and HEAD are supported",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GamesResponse": {
        "type": "object",
        "required": ["success", "games", "errors"],
        "properties": {
          "success": { "type": "boolean" },
          "games": { "type": "array", "items": { "$ref": "#/components/schemas/Game" } },
          "errors": { "type": "array", "items": { "type": "string" }, "description": "Game files that failed to load, if any." }
        }
      },
      "Game": {
        "type": "object",
        "required": ["id", "name", "status", "type", "description", "image", "order", "features"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["on", "soon"] },
          "type": { "type": "string", "enum": ["minecraft", "lpthub", ""] },
          "description": { "type": "string" },
          "image": { "type": "string", "description": "Image path, may be empty." },
          "order": { "type": "number" },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["category", "items"],
              "properties": {
                "category": { "type": "string" },
                "items": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "const": false },
          "error": { "type": "string" }
        }
      }
    }
  }
}
